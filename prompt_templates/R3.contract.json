{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                },
                "kind": {
                  "enum": [
                    "observation",
                    "claim",
                    "inference",
                    "hypothesis"
                  ]
                },
                "proposition": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "label",
                "kind",
                "proposition",
                "explanation",
                "provenance",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "title",
          "summary",
          "findings"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "no_finding_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    }
  },
  "required": [
    "memories",
    "no_finding_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "memories": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "no_finding_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "no_finding_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
